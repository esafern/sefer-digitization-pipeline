# [PRODUCTION]
import os
import sys
import json
import difflib
import time
import hashlib
import sqlite3
import fitz  # PyMuPDF
from google import genai
from google.genai import types

TEST_PDF = "test_page.pdf"
PAGE_INDEX = 0

BASE_TEXT = 'גליון: לומד חליצה קנין'
WITNESS_TEXT = 'גליון: לומר חליצה קנין'

CACHE_DB = "adjudication_cache.db"

def init_cache():
    conn = sqlite3.connect(CACHE_DB)
    conn.execute("CREATE TABLE IF NOT EXISTS cache (crop_hash TEXT PRIMARY KEY, decision_json TEXT)")
    conn.commit()
    conn.close()

def get_cached_decision(crop_bytes):
    conn = sqlite3.connect(CACHE_DB)
    cursor = conn.cursor()
    cursor.execute("SELECT decision_json FROM cache WHERE crop_hash = ?", (hashlib.sha256(crop_bytes).hexdigest(),))
    row = cursor.fetchone()
    conn.close()
    return row[0] if row else None

def cache_decision(crop_bytes, decision_json):
    conn = sqlite3.connect(CACHE_DB)
    conn.execute("INSERT OR REPLACE INTO cache (crop_hash, decision_json) VALUES (?, ?)", (hashlib.sha256(crop_bytes).hexdigest(), decision_json))
    conn.commit()
    conn.close()

def load_document_ai_json(json_path):
    with open(json_path, "r", encoding="utf-8") as f:
        return json.load(f)

def extract_spatial_tokens(doc_ai_data):
    tokens = []
    pages = doc_ai_data.get("pages", [])
    if not pages:
        return tokens
    
    page = pages[0]
    for token_obj in page.get("tokens", []):
        layout = token_obj.get("layout", {})
        text_anchor = token_obj.get("detectedBreak", {}) # simplified check
        
        # Extract bounding box vertices
        vertices = layout.get("boundingPoly", {}).get("normalizedVertices", [])
        if not vertices:
            continue
        
        xmin = min([v.get("x", 0.0) for v in vertices])
        xmax = max([v.get("x", 0.0) for v in vertices])
        ymin = min([v.get("y", 0.0) for v in vertices])
        ymax = max([v.get("y", 0.0) for v in vertices])
        
        # Extract text segment
        segment = layout.get("textAnchor", {}).get("textSegments", [{}])[0]
        # Fallback to scanning text directly from token layout if needed
        tokens.append({
            "xmin": xmin,
            "ymin": ymin,
            "xmax": xmax,
            "ymax": ymax
        })
    return tokens

def align_text_to_tokens(base_words, witness_words, doc_tokens):
    matcher = difflib.SequenceMatcher(None, base_words, witness_words)
    conflicts = []
    
    for tag, i1, i2, j1, j2 in matcher.get_opcodes():
        if tag == 'equal':
            continue
        for idx in range(i1, i2):
            token_idx = min(idx, len(doc_tokens) - 1)
            conflicts.append({
                "base_index": idx,
                "base_segment": base_words[idx],
                "witness_segment": witness_words[j1] if j1 < len(witness_words) else "",
                "token_index": token_idx,
                "bbox": doc_tokens[token_idx] if doc_tokens else {"xmin": 0, "ymin": 0, "xmax": 0, "ymax": 0},
                "tag": tag
            })
    return conflicts

def crop_pdf_bounding_box(pdf_path, page_idx, bbox):
    doc = fitz.open(pdf_path)
    page = doc[page_idx]
    rect = page.rect
    
    x0 = bbox["xmin"] * rect.width
    y0 = bbox["ymin"] * rect.height
    x1 = bbox["xmax"] * rect.width
    y1 = bbox["ymax"] * rect.height
    
    # Add a small padding boundary
    padding = 5.0
    crop_rect = fitz.Rect(max(0, x0 - padding), max(0, y0 - padding), min(rect.width, x1 + padding), min(rect.height, y1 + padding))
    
    pix = page.get_pixmap(clip=crop_rect, dpi=300)
    img_bytes = pix.tobytes("png")
    doc.close()
    return img_bytes

def adjudicate_conflict_with_gemini(crop_bytes, option_a, option_b, full_context):
    api_key = os.environ.get("GEMINI_API_KEY")
    if not api_key:
        raise ValueError("GEMINI_API_KEY environment variable is missing.")

    cached = get_cached_decision(crop_bytes)
    if cached:
        return cached

    client = genai.Client(api_key=api_key)

    prompt = f"""
You are a structural textual verification engine analyzing a Hebrew character matrix.

Surrounding Sentence Context: "{full_context}"

Evaluate the target raster crop against candidate strings:
Option A: "{option_a}"
Option B: "{option_b}"

CONSTRAINTS:
1. Validate token syntax against standard rabbinic abbreviation schemas (e.g., rejecting structurally invalid or non-existent acronym tokens).
2. Output "UNCERTAIN" if neither candidate maps deterministically to the pixel array or if semantic constraints are violated.

Respond ONLY with JSON using this structure:
{{
  "selected_option": "A" or "B" or "UNCERTAIN",
  "transcription_found": "exact text visible in image",
  "confidence": 0.0 to 1.0,
  "reasoning": "brief paleographic and contextual explanation"
}}
"""

    max_retries = 4
    for attempt in range(max_retries):
        try:
            response = client.models.generate_content(
                model="gemini-3.5-flash",
                contents=[
                    types.Part.from_bytes(data=crop_bytes, mime_type="image/png"),
                    prompt
                ],
                config=types.GenerateContentConfig(
                    response_mime_type="application/json"
                )
            )
            cache_decision(crop_bytes, response.text)
            return response.text
            
        except Exception as e:
            if "503" in str(e) or "429" in str(e):
                if attempt < max_retries - 1:
                    time.sleep((2 ** attempt) * 2)
                else:
                    raise e
            else:
                raise e

def run_pipeline():
    print("=" * 60)
    print("ORCHESTRATOR DIAGNOSTIC RUNNER")
    print("=" * 60)

    print(f"[1/5] Checking target PDF ('{TEST_PDF}')...", end=" ", flush=True)
    if not os.path.exists(TEST_PDF):
        print("MISSING!")
        sys.exit(1)
    print("FOUND.")

    json_path = f"./document_jsons/test_page-{PAGE_INDEX}.json"
    print(f"[2/5] Checking spatial JSON ('{json_path}')...", end=" ", flush=True)
    if not os.path.exists(json_path):
        print("MISSING!")
        sys.exit(1)
    print("FOUND.")

    init_cache()

    print("[3/5] Loading Document AI JSON...", end=" ", flush=True)
    try:
        doc_ai_data = load_document_ai_json(json_path)
        print("SUCCESS.")
    except Exception as e:
        print(f"FAILED: {e}")
        sys.exit(1)

    print("[4/5] Checking text streams for conflicts...")
    base_words = BASE_TEXT.split()
    witness_words = WITNESS_TEXT.split()
    doc_tokens = extract_spatial_tokens(doc_ai_data)
    print(f"Loaded {len(doc_tokens)} spatial tokens from Document AI.")

    conflicts = align_text_to_tokens(base_words, witness_words, doc_tokens)

    print("[5/5] Launching adjudication engine...")
    print("-" * 60)

    if not conflicts:
        print("No textual divergences found between base and witness texts.")
        return

    for conf in conflicts:
        print(f"\n[Conflict #1] Tag: '{conf['tag']}'")
        print(f"  Base Reading:     '{conf['base_segment']}'")
        print(f"  Witness Reading:  '{conf['witness_segment']}'")
        print(f"  Mapped Base index {conf['base_index']} -> Token index {conf['token_index']}")
        
        target_bbox = conf['bbox']
        print(f"  Target BBox:     {target_bbox}")

        print("  Cropping PDF region...")
        crop_bytes = crop_pdf_bounding_box(TEST_PDF, PAGE_INDEX, target_bbox)

        print("  Submitting crop to Gemini (or cache lookup)...")
        full_context_str = " ".join(base_words)
        decision = adjudicate_conflict_with_gemini(crop_bytes, conf['base_segment'], conf['witness_segment'], full_context_str)
        print("  Adjudication Result:")
        print(f"  {decision}")

    print("-" * 60)
    print("ORCHESTRATOR COMPLETE.")

if __name__ == "__main__":
    run_pipeline()
